---
/**
 * ArticleBlock — per-article render with tabs (Recitals / Drafting History
 * / AI Omnibus / Case Law / Guidance).
 *
 * Step 4.3b: takes a `lang` prop and consumes the loader. Internal links
 * are locale-prefixed. House principle: AI Act class names + JSX
 * structure preserved verbatim from the pre-i18n version.
 *
 * Omnibus on /nl/: EN body + Dutch chrome tag ("Bron: COM(2025) 836 —
 * beschikbaar in het Engels") per the 4.3b decision recorded with Pavle.
 * UI chrome strings (tab labels) stay English on both locales.
 *
 * Step 5.3 (2026-04-28): the Guidance tab is wired to real data from
 * `getGuidanceCitationsForArticle`. The tab and panel are both hidden when
 * the article has zero citations in the current language — same convention
 * as the Recitals / History / Omnibus tabs. Cards aggregate by
 * (guidance_id, language); multiple pin-cites within the same article
 * collapse into a single card with the pin-cites listed inside it. Sort:
 * adoption_date desc, canonical_id asc tie-break (deterministic for
 * byte-identical re-builds). Decision 4-D (Brontaal: source language
 * label) is delegated to GuidanceCard's title fallback. The i18n metadata
 * silent-fallback case (multi-lang doc, target title not yet ingested)
 * lives in `getGuidanceTitleFor` and is also surfaced via the same card.
 * The two cases differ in whether the doc has the page language in
 * `doc.languages`; comments at the call site describe the distinction.
 */
import {
  getRelatedRecitals,
  getOmnibusAmendmentsForArticle,
  getDraftingSnapshotsForArticle,
  getDraftingHistoryGaps,
  getDraftingStages,
  getGuidanceCitationsForArticle,
  getGuidanceDoc,
  getGuidanceTitleFor,
  getInternalReferencesFor,
  getExternalReferencesFor,
  getReferencedBy,
  getChapterForArticle,
} from '@/lib/loader';
import ParagraphCitations from '@components/ParagraphCitations.astro';
import { wrapReferences } from '@/lib/references';
import type { Article, GuidanceCitation, GuidanceDoc, Lang } from '@/types/aiact';
import DraftingHistory from '@/components/DraftingHistory.astro';
import GuidanceCard from '@/components/GuidanceCard.astro';
import SupplementaryTabs from '@/components/SupplementaryTabs.astro';
import SupplementaryPanel from '@/components/SupplementaryPanel.astro';
import SupplementaryHeader from '@/components/SupplementaryHeader.astro';
import ResearchPanel from '@/components/ResearchPanel.astro';

interface Props {
  article: Article;
  lang: Lang;
}

const { article, lang } = Astro.props;

// Resolve related recitals — language-resolved via loader.
const relatedRecitals = getRelatedRecitals(article.number, lang).map((rec) => ({
  number: rec.number,
  text: rec.text,
  href: '/' + lang + '/aiact/rec/' + rec.number + '/',
}));

// Drafting history — bilingual via loader (4.4). Snapshots in this article's
// language at every stage that covers it; gaps surface where the alternate
// language has coverage but this one does not (Decision 3, bidirectional).
const draftingSnapshots = getDraftingSnapshotsForArticle(article.number, lang);
const draftingGaps = getDraftingHistoryGaps(article.number, 'articles');
const draftingStages = getDraftingStages(lang);

// Omnibus amendments — EN data; on /nl/ render with NL chrome tag.
const omnibusAmendments = getOmnibusAmendmentsForArticle(article.number);

// Guidance — 5.3: aggregate per (guidance_id, language) and sort by
// adoption_date desc with canonical_id tie-break.
//
// The loader's `getGuidanceCitationsForArticle(articleNumber, lang)` already
// filters to the current language. This means the (guidance_id, language)
// aggregation key is effectively (guidance_id) per page render. The language
// is kept in the key for defensive symmetry against a future loader change
// that returns mixed-language entries (e.g. "show fallback" semantics).
type PinCiteEntry = {
  pin_cite: GuidanceCitation['pin_cite'];
  location_in_doc: GuidanceCitation['location_in_doc'];
};
type GuidanceCardData = {
  doc: GuidanceDoc;
  pinCites: PinCiteEntry[];
};

const guidanceCitations = getGuidanceCitationsForArticle(article.number, lang);
const guidanceAggregated = new Map<string, GuidanceCardData>();
for (const cit of guidanceCitations) {
  const key = `${cit.guidance_id}::${cit.language}`;
  let entry = guidanceAggregated.get(key);
  if (!entry) {
    const doc = getGuidanceDoc(cit.guidance_id);
    if (!doc) {
      // Dangling citation — should be impossible after 4.6's verifier ran.
      // Skip silently so the rest of the page still renders. 5.4's reverse-
      // link audit will pick this up if it does happen.
      continue;
    }
    entry = { doc, pinCites: [] };
    guidanceAggregated.set(key, entry);
  }
  entry.pinCites.push({
    pin_cite: cit.pin_cite,
    location_in_doc: cit.location_in_doc,
  });
}

// Decision 4 fallback semantics — applied at the card level inside
// GuidanceCard via `getGuidanceTitleFor`:
//   - Decision 4-D (single-language source, e.g. an EN-only doc on /nl/):
//     `doc.languages` does NOT include current `lang`. Title resolves to the
//     other language and the card renders an explicit "Brontaal: …" /
//     "Source language: …" label. The aggregated tab itself only contains
//     this case if a future loader change starts surfacing other-language
//     citations on the matching page; today it cannot, because the loader
//     filters citations to current language.
//   - i18n Decision 3 metadata rule (multi-lang doc, current-lang title not
//     yet ingested): `doc.languages` DOES include current `lang`, but
//     `doc.title[lang]` is null. `getGuidanceTitleFor` silently falls back
//     to EN — no label. The 5.2 EZ guide carries both titles so this branch
//     never fires for the current corpus; first single-lang doc in 5.6+
//     exercises Decision 4-D, and an asymmetric ingestion gap exercises the
//     silent-fallback path.
//
// Both branches resolve through the same component property, but the two
// cases are conceptually distinct — keep this comment if the rendering
// diverges.
const guidanceCards: GuidanceCardData[] = Array.from(guidanceAggregated.values()).sort((a, b) => {
  const da = (a.doc.adoption_date ?? '').replace(/-/g, '');
  const db = (b.doc.adoption_date ?? '').replace(/-/g, '');
  if (da !== db) return db.localeCompare(da);
  return (a.doc.canonical_id ?? '').localeCompare(b.doc.canonical_id ?? '');
});

// Article references (4.9b). The structured indexes are language-agnostic;
// the URL composition for external EUR-Lex links is language-aware via the
// LANG querystring parameter inside `wrapReferences`. Internal Astro routes
// pick up the current `lang` directly. Empty arrays are fine — the wrapper
// returns the original text untouched when there's nothing to annotate.
const internalRefs = getInternalReferencesFor(article.number, lang);
const externalRefs = getExternalReferencesFor(article.number, lang);
// Phase 2 (FF_UNIFIED_REFERENCES): "Referenced by" block via unified
// references table. Filter to article sources (matches legacy semantic;
// excludes recital→article reverse-edges which are surfaced separately).
const referencedByEntries = getReferencedBy(`aiact/art/${article.number}`)
  .filter((ref) => ref.source.startsWith('aiact/art/'))
  .map((ref) => {
    const sourceArticle = ref.source.replace('aiact/art/', '');
    const ch = getChapterForArticle(sourceArticle);
    const href = ch === null
      ? '#'
      : `/${lang}/aiact/art/${sourceArticle}/`;
    let pin = '';
    if (ref.sourcePin?.paragraph) {
      pin = `(${ref.sourcePin.paragraph})`;
      if (ref.sourcePin.letter) pin += `(${ref.sourcePin.letter})`;
    }
    return {
      source_article: sourceArticle,
      href,
      pin,
    };
  });

const recitalCount = relatedRecitals.length;
// Tab count: stages where THIS language has a snapshot, plus stages where
// THIS language has a Decision-3 gap disclosure (so the user is told something
// at every stage where it's relevant). Final-2024 always exists (live
// regulation) so we add 1.
const historyStageCardCount = draftingStages.filter((stage) => {
  const hasSnap = draftingSnapshots.some((s) => s.stage === stage.id);
  const hasGap = draftingGaps.some((g) => g.stage === stage.id && g.missing_in === lang);
  return hasSnap || hasGap;
}).length;
const historyCount = historyStageCardCount + 1; // +1 for final-2024 card
const omnibusCount = omnibusAmendments.length;
const guidanceCount = guidanceCards.length;

const articleHref = '/' + lang + '/aiact/art/' + article.number + '/';

// Phase 5.5a: supplementary surface — tabs in locked chronological
// order (OQ-4). Implementation and Decisions are Phase 4 empty stubs;
// they auto-show when content ops populates them. AI Omnibus retires
// from the tab strip (OQ-4: amendment is versioning, not a category)
// and surfaces in an interim placeholder block above the tabs until
// Phase 6 lights up the proper AmendmentCallout / VersionBanner / sidebar
// surface.
const supplementaryTabs = [
  { slug: 'history',        label: 'History',        count: historyCount },
  { slug: 'implementation', label: 'Implementation', count: 0 },
  { slug: 'recitals',       label: 'Recitals',       count: recitalCount },
  { slug: 'decisions',      label: 'Decisions',      count: 0 },
  { slug: 'guidance',       label: 'Guidance',       count: guidanceCount },
];

// Phase 5.5b: Research mode — flat cross-source entry list. Same data
// as Browse mode, different framing. Each entry maps onto a unified
// shape (category, title, meta, snippet, date) so the panel renders
// heterogeneously-sourced entries with consistent typography. Sort:
// date desc, secondary by category then natural order.
//
// Date proxies per category — recital and history sorting against a
// stable real-world date lets the reader see the temporal narrative
// from newest interpretation to oldest drafting trace:
//   - history → DraftingStage.date (per-stage publication date)
//   - recitals → 2024-07-12 (OJ publication of Regulation 2024/1689,
//     shared by all recitals — they're part of the same legislative
//     act, so a uniform date is the most defensible proxy)
//   - guidance → GuidanceDoc.adoption_date
function truncateSnippet(text: string, max = 220): string {
  const flat = text.replace(/\s+/g, ' ').trim();
  if (flat.length <= max) return flat;
  return flat.slice(0, max).replace(/\s+\S*$/, '') + '…';
}
const REGULATION_DATE = '2024-07-12';
const stageById = new Map(draftingStages.map((s) => [s.id, s] as const));

type ResearchEntry = {
  category: string;
  categoryLabel: string;
  tagDetail?: string;
  title: string;
  metaLeft?: string;
  metaRight?: string;
  snippet: string;
  date: string;
  href?: string;
};

const historyEntries: ResearchEntry[] = draftingSnapshots.map((snap) => {
  const stage = stageById.get(snap.stage);
  const stageLabel = stage ? (lang === 'nl' ? stage.label_nl : stage.label_en) : snap.stage;
  return {
    category: 'history',
    categoryLabel: lang === 'nl' ? 'Geschiedenis' : 'History',
    tagDetail: stageLabel,
    title: `Article ${snap.number} — ${stageLabel}`,
    metaLeft: stage?.date,
    metaRight: stage?.source_label,
    snippet: truncateSnippet(snap.text),
    date: stage?.date ?? '1900-01-01',
    href: `/${lang}/aiact/history/${snap.stage}/art/${snap.number}/`,
  };
});

const recitalEntries: ResearchEntry[] = relatedRecitals.map((rec) => ({
  category: 'recitals',
  categoryLabel: lang === 'nl' ? 'Overweging' : 'Recital',
  tagDetail: `Recital ${rec.number}`,
  title: `Recital ${rec.number}`,
  metaLeft: 'Regulation (EU) 2024/1689',
  snippet: truncateSnippet(rec.text),
  date: REGULATION_DATE,
  href: rec.href,
}));

const guidanceEntries: ResearchEntry[] = guidanceCards.map(({ doc, pinCites }) => {
  const title = getGuidanceTitleFor(doc, lang).title;
  // Snippet: short pin-cite locator summary. The doc body excerpts
  // aren't in the schema today; the location_in_doc string is the
  // best descriptive cue we have. Truncate to the first three.
  const pinSummary = pinCites
    .map((pc) => {
      const para = pc.pin_cite?.paragraph;
      const letter = pc.pin_cite?.letter;
      const loc = pc.location_in_doc?.label;
      const ref = para ? `Art. ${article.number}(${para}${letter ? `)(${letter}` : ''})` : `Art. ${article.number}`;
      return loc ? `${ref} → ${loc}` : ref;
    })
    .slice(0, 3)
    .join(' · ');
  const sourceLabels: Record<string, string> = {
    commission: 'European Commission',
    ai_office: 'AI Office',
    edpb: 'EDPB',
    member_state: 'Member State',
    other: 'Other',
  };
  return {
    category: 'guidance',
    categoryLabel: lang === 'nl' ? 'Leidraad' : 'Guidance',
    tagDetail: sourceLabels[doc.source] ?? doc.source,
    title,
    metaLeft: doc.adoption_date,
    metaRight: doc.canonical_id,
    snippet: pinSummary || `${doc.document_type} from ${sourceLabels[doc.source] ?? doc.source}`,
    date: doc.adoption_date ?? '1900-01-01',
    href: `/${lang}/guidance/${doc.canonical_id.replace(/\//g, '-')}/`,
  };
});

const researchEntries: ResearchEntry[] = [
  ...historyEntries,
  ...recitalEntries,
  ...guidanceEntries,
].sort((a, b) => {
  const d = (b.date || '').localeCompare(a.date || '');
  if (d !== 0) return d;
  if (a.category !== b.category) return a.category.localeCompare(b.category);
  return a.title.localeCompare(b.title);
});

const researchCategories = [
  { slug: 'history',  label: 'History',  count: historyCount },
  { slug: 'recitals', label: 'Recitals', count: recitalCount },
  { slug: 'guidance', label: 'Guidance', count: guidanceCount },
];

const totalSupplementaryEntries = researchEntries.length;

function parseSubPoints(text: string) {
  const parts: { marker?: string; text: string }[] = [];
  const lines = text.split('\n');
  let currentText = '';
  let currentMarker: string | undefined;

  for (const line of lines) {
    const subMatch = line.match(/^\(([a-z])\)\s*/);
    if (subMatch) {
      if (currentText.trim()) {
        parts.push({ marker: currentMarker, text: currentText.trim() });
      }
      currentMarker = `(${subMatch[1]})`;
      currentText = line.replace(/^\([a-z]\)\s*/, '');
    } else {
      currentText += (currentText ? '\n' : '') + line;
    }
  }
  if (currentText.trim()) {
    parts.push({ marker: currentMarker, text: currentText.trim() });
  }
  return parts;
}

---

<div class="article-block" id={`article-${article.number}`}>
  <div class="article-header">
    <div>
      <span class="article-id">Article {article.number}</span>
      <span class="article-title-text">{article.title}</span>
    </div>
    <div class="article-badges">
      <div class="article-tools">
        <a class="article-tool-btn" href={articleHref} title="Permalink to Article">&#x1f517;</a>
      </div>
    </div>
  </div>

  <div class="article-body">
    {article.paragraphs.map((para: any) => {
      const parts = parseSubPoints(para.text);
      const hasNumber = para.number && para.number !== '0';

      // Wrap recognised reference patterns in <a> tags. The wrapper does
      // its own substring search per chunk — see lib/references.ts.
      const annotated = parts.map((part) => ({
        ...part,
        html: wrapReferences(part.text, internalRefs, externalRefs, lang).replace(/\n/g, '<br/>'),
      }));

      return (
        <>
          <div class="para-row" id={para.id ?? undefined}>
            {hasNumber && <div class="para-num">{para.number}.</div>}
            <div class={`para-text${!hasNumber ? ' para-text-full' : ''}`}>
              {annotated.map((part, i) => (
                part.marker ? (
                  <div class="sub-para">
                    <div class="sub-para-marker">{part.marker}</div>
                    <div set:html={part.html} />
                  </div>
                ) : (
                  <span set:html={part.html} />
                )
              ))}
            </div>
          </div>
          {hasNumber && (
            <ParagraphCitations
              article={article.canonical_id}
              paragraph={para.number}
            />
          )}
        </>
      );
    })}
  </div>

  {/* Phase 5.5a: Omnibus interim placeholder block. The 29 AI Omnibus
       amendment records used to live inside a dedicated tab; per OQ-4
       the tab retires (amendment is versioning, not a category) and
       the records surface here above the supplementary surface until
       Phase 6 wires the AmendmentCallout / VersionBanner / sidebar
       proper amendment surface. Visual treatment uses status-proposed
       tokens — amber palette signalling a forthcoming change. */}
  {omnibusCount > 0 && (
    <section class="omnibus-placeholder" aria-label="Forthcoming amendments (AI Omnibus)">
      <header class="omnibus-placeholder-head">
        <span class="omnibus-placeholder-eyebrow">
          {lang === 'nl' ? 'Aankomende wijzigingen' : 'Forthcoming changes'}
        </span>
        <span class="omnibus-placeholder-source">AI Omnibus · COM(2025) 836 final · proposed</span>
      </header>
      {omnibusAmendments.map((amend: any) => (
        <article class="omnibus-placeholder-card">
          <header class="omnibus-placeholder-card-head">
            <span class="omnibus-placeholder-pin">Paragraph {amend.paragraph}</span>
            <span class="omnibus-placeholder-action">{amend.action}</span>
            {amend.sub_provision && (
              <span class="omnibus-placeholder-sub-provision">({amend.sub_provision})</span>
            )}
          </header>
          <p class="omnibus-placeholder-summary">{amend.summary}</p>
          {lang === 'nl' && (
            <p class="omnibus-placeholder-nl-note">
              Bron: COM(2025) 836 — beschikbaar in het Engels
            </p>
          )}
        </article>
      ))}
    </section>
  )}

  {/* Phase 5.5a/b: supplementary surface — replaces the legacy
       `.article-tabs` strip. Wrapped in a mode-scoped root so the
       Phase 5.5b mode toggle (Browse / Research) can show/hide the
       two body shapes without re-fetching data. `data-supp-mode`
       starts as 'browse'; BaseLayout's switchMode flips it on click
       or keyboard `R`, and persists the choice per session via
       sessionStorage. */}
  {totalSupplementaryEntries > 0 && (
    <section class="supp-root" data-article={String(article.number)} data-supp-mode="browse">
      <SupplementaryHeader
        articleNumber={String(article.number)}
        totalEntries={totalSupplementaryEntries}
      />

      <div class="supp-browse">
        <SupplementaryTabs articleNumber={String(article.number)} tabs={supplementaryTabs} />

        {historyCount > 0 && (
          <SupplementaryPanel articleNumber={String(article.number)} slug="history">
            <DraftingHistory
              snapshots={draftingSnapshots}
              gaps={draftingGaps}
              stages={draftingStages}
              lang={lang}
              number={article.number}
              contentType="articles"
              currentText={article.paragraphs.map((p: any) => p.text).join('\n\n')}
              currentParaCount={article.paragraphs.length}
              currentTitle={article.title}
            />
          </SupplementaryPanel>
        )}

        {recitalCount > 0 && (
          <SupplementaryPanel articleNumber={String(article.number)} slug="recitals">
            {relatedRecitals.map((rec) => (
              <div class="recital-card">
                <div class="recital-card-header">
                  <a href={rec.href}>Recital {rec.number}</a>
                </div>
                <p>{rec.text.length > 300 ? rec.text.substring(0, 300) + '…' : rec.text}</p>
              </div>
            ))}
          </SupplementaryPanel>
        )}

        {guidanceCount > 0 && (
          <SupplementaryPanel articleNumber={String(article.number)} slug="guidance">
            {guidanceCards.map(({ doc, pinCites }) => (
              <GuidanceCard doc={doc} lang={lang} showPinCites={pinCites} />
            ))}
          </SupplementaryPanel>
        )}
      </div>

      <ResearchPanel
        articleNumber={String(article.number)}
        entries={researchEntries}
        categories={researchCategories}
      />
    </section>
  )}

  {referencedByEntries.length > 0 && (
    <div class="referenced-by">
      <div class="referenced-by-label">
        {lang === 'nl' ? 'Aangehaald door' : 'Referenced by'}
      </div>
      <ul class="referenced-by-list">
        {referencedByEntries.map((entry) => (
          <li>
            <a href={entry.href}>Article {entry.source_article}{entry.pin}</a>
          </li>
        ))}
      </ul>
    </div>
  )}
</div>

<style>
  /* ── Omnibus interim placeholder (Phase 5.5a) ─────────────────
     Status-proposed (amber) palette. This block surfaces above the
     supplementary surface so the reader meets the forthcoming change
     before they reach the History / Recitals / Guidance tabs — same
     editorial intent as the Phase 6 VersionBanner that will eventually
     replace it. Each amendment renders as a flat card; no left-border
     rail or boxy border, because the colour palette alone carries the
     "forthcoming change" signal. */
  .omnibus-placeholder {
    margin: 1.8rem 0 0;
    padding: 1rem 1.1rem 0.6rem;
    background: var(--status-proposed-bg, #f6e6c7);
    border: 1px solid color-mix(in srgb, var(--status-proposed-fg, #7a4a00) 18%, transparent);
    border-radius: 5px;
    font-family: var(--font-ui);
  }
  .omnibus-placeholder-head {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-bottom: 0.6rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--status-proposed-fg, #7a4a00) 15%, transparent);
  }
  .omnibus-placeholder-eyebrow {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--status-proposed-fg, #7a4a00);
    font-weight: 600;
  }
  .omnibus-placeholder-source {
    font-size: 11.5px;
    color: var(--stone-600, #504d42);
  }
  .omnibus-placeholder-card {
    padding: 0.6rem 0;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--stone-800, #26241e);
  }
  .omnibus-placeholder-card + .omnibus-placeholder-card {
    border-top: 1px solid color-mix(in srgb, var(--status-proposed-fg, #7a4a00) 10%, transparent);
  }
  .omnibus-placeholder-card-head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.3rem;
  }
  .omnibus-placeholder-pin {
    font-family: var(--font-mono, monospace);
    font-size: 11.5px;
    color: var(--stone-700, #3a382f);
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid color-mix(in srgb, var(--status-proposed-fg, #7a4a00) 18%, transparent);
    padding: 1px 6px;
    border-radius: 3px;
  }
  .omnibus-placeholder-action {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--status-proposed-fg, #7a4a00);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .omnibus-placeholder-sub-provision {
    font-size: 12.5px;
    color: var(--stone-600, #504d42);
    font-style: italic;
  }
  .omnibus-placeholder-summary {
    margin: 0;
    color: var(--stone-800, #26241e);
  }
  .omnibus-placeholder-nl-note {
    margin: 0.4rem 0 0;
    font-size: 11px;
    font-style: italic;
    color: var(--stone-600, #504d42);
  }
</style>
