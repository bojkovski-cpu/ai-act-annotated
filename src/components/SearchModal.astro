---
/**
 * SearchModal — Phase 5.6.
 *
 * Pagefind-backed search modal. Shell only: the actual input + results
 * list are mounted into `#search-modal-mount` by Pagefind's default UI
 * (the `@pagefind/default-ui` package, served as a static script from
 * `/pagefind/pagefind-ui.js` after `pagefind --site dist` runs as part
 * of `npm run build`).
 *
 * Phase 5.6 ships the default UI for ship-1 velocity. Phase 5.7+ (the
 * FF_CONVERGENT_COMPONENTS chrome flip) is the natural moment to
 * replace the default UI with a custom stone-toned modal that mirrors
 * the design bundle's chrome — by then the surrounding TopBar and
 * sidebar will be on the new palette too, and the search modal can
 * land in its final form alongside.
 *
 * Open / close lifecycle:
 *   - Default state: data-search-open="false" (display: none on the
 *     overlay).
 *   - openSearchModal() (in BaseLayout's inline script): sets
 *     data-search-open="true", locks body scroll, lazily initialises
 *     PagefindUI on first open (subsequent opens reuse the instance),
 *     focuses the Pagefind input.
 *   - closeSearchModal(): clears the flag, unlocks scroll. The
 *     PagefindUI instance stays mounted between opens (cheap re-show).
 *
 * Bilingual: Pagefind auto-detects `<html lang>` set by BaseLayout and
 * scopes results to the current locale. No explicit language switching
 * in the UI — the user is on EN or NL, they search within EN or NL.
 *
 * Pagefind in dev: `astro dev` doesn't run `pagefind`, so the JS bundle
 * 404s and search silently no-ops in dev. Production builds (the GHA
 * workflow now runs `npm run build` which chains `pagefind --site dist`
 * after astro build) generate the index and the UI script.
 */
import type { Lang } from '@/types/aiact';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const HEADING: Record<Lang, string> = {
  en: 'Search the AI Act',
  nl: 'Doorzoek de AI-verordening',
};
const CLOSE_LABEL: Record<Lang, string> = {
  en: 'Close search',
  nl: 'Zoeken sluiten',
};
const DEV_HINT: Record<Lang, string> = {
  en: 'Search index is built at deploy time — it is unavailable in local dev.',
  nl: 'De zoekindex wordt bij deploy gegenereerd — niet beschikbaar in lokale dev.',
};
---

<div
  class="search-modal"
  data-search-open="false"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-modal-heading"
  hidden
>
  <div class="search-modal-backdrop" data-search-backdrop></div>

  <div class="search-modal-card" role="document">
    <header class="search-modal-head">
      <h2 id="search-modal-heading" class="search-modal-heading">{HEADING[lang]}</h2>
      <button
        type="button"
        class="search-modal-close"
        aria-label={CLOSE_LABEL[lang]}
        data-search-close
      >&times;</button>
    </header>

    <div id="search-modal-mount" class="search-modal-mount" data-lang={lang}></div>

    <noscript>
      <p class="search-modal-dev-note">JavaScript is required for search.</p>
    </noscript>
    <p class="search-modal-dev-note" data-search-dev-hint hidden>{DEV_HINT[lang]}</p>
  </div>
</div>

<style is:global>
  /* ── Search modal (Phase 5.6) ────────────────────────────────
     Overlay with dark backdrop + centered card. Pagefind UI mounts
     into .search-modal-mount and brings its own input + results
     styling. We wrap it with a stone-toned shell and a header
     bar; the inner UI inherits its own default-UI look for now.
     Phase 5.7+ will replace the default UI with a custom modal
     that matches the chrome flip. */
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 8vh 1rem 1rem;
    font-family: var(--font-ui, sans-serif);
  }
  .search-modal[data-search-open="false"] {
    display: none;
  }
  .search-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(21, 20, 15, 0.55);
    backdrop-filter: blur(2px);
  }
  .search-modal-card {
    position: relative;
    width: 100%;
    max-width: 640px;
    background: var(--surface, #fff);
    border: 1px solid var(--stone-200, #d8d5cb);
    border-radius: 8px;
    box-shadow: var(--shadow-lg, 0 20px 50px -10px rgba(21, 20, 15, 0.25));
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .search-modal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 1.1rem;
    border-bottom: 1px solid var(--stone-150, #e4e2da);
    background: var(--stone-50, #fafaf8);
  }
  .search-modal-heading {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--stone-800, #26241e);
    font-family: var(--font-ui, sans-serif);
  }
  .search-modal-close {
    appearance: none;
    border: 0;
    background: transparent;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    color: var(--stone-500, #6a6658);
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-sm, 3px);
    transition: background var(--dur-1, 120ms) var(--ease, ease),
                color var(--dur-1, 120ms) var(--ease, ease);
  }
  .search-modal-close:hover {
    background: var(--stone-150, #e4e2da);
    color: var(--stone-900, #15140f);
  }
  .search-modal-mount {
    flex: 1;
    overflow-y: auto;
    padding: 0.6rem 0.8rem 1rem;
    /* Override Pagefind default-UI variables to nudge it toward our
       stone palette without writing a full theme. */
    --pagefind-ui-primary: var(--stone-900, #15140f);
    --pagefind-ui-text: var(--stone-800, #26241e);
    --pagefind-ui-background: var(--surface, #fff);
    --pagefind-ui-border: var(--stone-200, #d8d5cb);
    --pagefind-ui-tag: var(--stone-150, #e4e2da);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 4px;
    --pagefind-ui-image-border-radius: 4px;
    --pagefind-ui-font: var(--font-ui, sans-serif);
  }
  .search-modal-dev-note {
    margin: 0;
    padding: 0.5rem 1.1rem 0.8rem;
    font-size: 11.5px;
    color: var(--stone-500, #6a6658);
    border-top: 1px solid var(--stone-150, #e4e2da);
    font-style: italic;
  }
  body[data-search-locked="true"] {
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .search-modal {
      padding: 3vh 0.5rem 0.5rem;
    }
    .search-modal-card {
      max-height: 92vh;
    }
  }
</style>
