---
/**
 * TopBar — site-wide masthead. Step 5.2: bilingual nav chrome + GUIDANCE entry.
 *
 * Phase 5.6.1 (2026-05-12): search field is the primary input (no modal,
 * no backdrop). Typing in the field triggers a debounced Pagefind query;
 * results render in a dropdown panel anchored below the topbar so the
 * underlying article stays visible. The search JS lives in
 * BaseLayout's inline script. ⌘K / Ctrl-K focus the input (the listener
 * is in BaseLayout too).
 */
import LanguageToggle from './LanguageToggle.astro';
import type { Lang } from '../types/aiact';

type TopNavSection = 'articles' | 'recitals' | 'annexes' | 'history' | 'guidance' | 'about';

interface Props {
  lang: Lang;
  currentPath: string;
  activeTopNav?: TopNavSection;
  availableLangs?: readonly Lang[];
}

const { lang, currentPath, activeTopNav, availableLangs } = Astro.props;

const noLang = currentPath.replace(/^\/(en|nl)(\/|$)/, '/');
const topNav: TopNavSection = activeTopNav
  ?? (noLang.startsWith('/recitals') ? 'recitals'
    : noLang.startsWith('/annexes') ? 'annexes'
    : noLang.startsWith('/history') ? 'history'
    : noLang.startsWith('/guidance') ? 'guidance'
    : noLang.startsWith('/about') ? 'about'
    : 'articles');

const langPrefix = '/' + lang;
const articlesHref = langPrefix + '/articles/';
const recitalsHref = langPrefix + '/recitals/';
const annexesHref = langPrefix + '/annexes/';
const historyHref = langPrefix + '/history/';
const guidanceHref = langPrefix + '/guidance/';
const aboutHref = langPrefix + '/about/';

const NAV_LABELS: Record<Lang, Record<TopNavSection, string>> = {
  en: {
    articles: 'ARTICLES',
    recitals: 'RECITALS',
    annexes: 'ANNEXES',
    history: 'DRAFTING HISTORY',
    guidance: 'GUIDANCE',
    about: 'ABOUT',
  },
  nl: {
    articles: 'ARTIKELEN',
    recitals: 'OVERWEGINGEN',
    annexes: 'BIJLAGEN',
    history: 'TOTSTANDKOMINGSGESCHIEDENIS',
    guidance: 'RICHTSNOEREN',
    about: 'OVER',
  },
};

const SEARCH_PLACEHOLDER: Record<Lang, string> = {
  en: 'Search articles, recitals…',
  nl: 'Zoek artikelen, overwegingen…',
};
const SEARCH_LABEL: Record<Lang, string> = {
  en: 'Search the AI Act',
  nl: 'Doorzoek de AI-verordening',
};
const BRAND_SUB: Record<Lang, string> = {
  en: 'Annotated Edition',
  nl: 'Geannoteerde editie',
};

const labels = NAV_LABELS[lang];
---

<div class="topbar">
  <div class="topbar-upper">
    <div class="topbar-brand">EU AI Act<span>{BRAND_SUB[lang]}</span></div>
    <div class="topbar-search" data-search-root>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input
        type="text"
        placeholder={SEARCH_PLACEHOLDER[lang]}
        id="search-input"
        aria-label={SEARCH_LABEL[lang]}
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="topbar-search-kbd" aria-hidden="true" data-search-kbd>⌘K</kbd>
      <div
        id="search-results-panel"
        class="topbar-search-panel"
        role="listbox"
        aria-label="Search results"
        hidden
      ></div>
    </div>
    <LanguageToggle lang={lang} currentPath={currentPath} availableLangs={availableLangs} />
  </div>
  <nav class="topbar-nav">
    <a href={articlesHref} class={topNav === 'articles' ? 'active' : ''}>{labels.articles}</a>
    <span class="topbar-nav-sep">|</span>
    <a href={recitalsHref} class={topNav === 'recitals' ? 'active' : ''}>{labels.recitals}</a>
    <span class="topbar-nav-sep">|</span>
    <a href={annexesHref} class={topNav === 'annexes' ? 'active' : ''}>{labels.annexes}</a>
    <span class="topbar-nav-sep">|</span>
    <a href={historyHref} class={topNav === 'history' ? 'active' : ''}>{labels.history}</a>
    <span class="topbar-nav-sep">|</span>
    <a href={guidanceHref} class={topNav === 'guidance' ? 'active' : ''}>{labels.guidance}</a>
    <span class="topbar-nav-sep">|</span>
    <a href={aboutHref} class={topNav === 'about' ? 'active' : ''}>{labels.about}</a>
  </nav>
</div>

<style is:global>
  /* Phase 5.6.1 — search field is a live input + a dropdown panel
     anchored below it. No modal, no backdrop. The dropdown overlays
     the topbar-nav and the article column below the topbar; content
     behind it stays visible. 5.7 chrome flip will reskin the whole
     topbar, at which point this section converges with the new
     palette. */
  .topbar-search {
    position: relative;
  }
  .topbar-search-kbd {
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    padding: 2px 6px;
    border: 1px solid var(--stone-200, #d8d5cb);
    border-radius: 3px;
    background: var(--stone-50, #fafaf8);
    color: var(--stone-600, #504d42);
    margin-left: 0.5rem;
    letter-spacing: 0.02em;
    pointer-events: none;
  }
  .topbar-search-panel {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    width: min(520px, 92vw);
    max-height: 70vh;
    overflow-y: auto;
    background: #fff;
    border: 1px solid var(--stone-200, #d8d5cb);
    border-radius: 6px;
    box-shadow: var(--shadow-lg, 0 20px 50px -10px rgba(21, 20, 15, 0.20));
    z-index: 200;
    font-family: var(--font-ui, sans-serif);
    font-size: 13px;
    color: var(--stone-800, #26241e);
  }
  .topbar-search-panel[hidden] {
    display: none;
  }
  .topbar-search-panel-meta {
    padding: 0.55rem 0.8rem;
    font-size: 11.5px;
    color: var(--stone-500, #6a6658);
    border-bottom: 1px solid var(--stone-150, #e4e2da);
    background: var(--stone-50, #fafaf8);
    border-radius: 6px 6px 0 0;
  }
  .topbar-search-panel-meta b {
    color: var(--stone-700, #3a382f);
    font-weight: 600;
  }
  .topbar-search-panel-empty {
    padding: 1rem;
    color: var(--stone-500, #6a6658);
    font-size: 12.5px;
    text-align: center;
  }
  .topbar-search-panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .topbar-search-panel li + li {
    border-top: 1px solid var(--stone-150, #e4e2da);
  }
  .topbar-search-panel li a {
    display: block;
    padding: 0.7rem 0.9rem;
    color: inherit;
    text-decoration: none;
    transition: background var(--dur-1, 120ms) var(--ease, ease);
  }
  .topbar-search-panel li a:hover,
  .topbar-search-panel li a:focus-visible {
    background: var(--stone-50, #fafaf8);
    outline: none;
  }
  .topbar-search-panel-title {
    color: var(--stone-900, #15140f);
    font-weight: 600;
    font-size: 13.5px;
    margin: 0 0 0.2rem;
    line-height: 1.35;
  }
  .topbar-search-panel-url {
    color: var(--stone-500, #6a6658);
    font-size: 11px;
    font-family: var(--font-mono, monospace);
    margin: 0 0 0.3rem;
  }
  .topbar-search-panel-excerpt {
    color: var(--stone-700, #3a382f);
    font-size: 12.5px;
    line-height: 1.5;
    margin: 0;
  }
  .topbar-search-panel-excerpt mark {
    background: #fdf6e3;
    color: var(--stone-900, #15140f);
    padding: 0 2px;
    border-radius: 2px;
  }
  body[data-search-locked="true"] {
    /* Phase 5.6 leftover — no longer applied, but defensive in case
       any stale state lingers from a prior page render. */
    overflow: visible;
  }
</style>
