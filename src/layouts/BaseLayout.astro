---
// Phase 5.1: load family-wide design tokens (stone + deep-legal-blue,
// Source Serif 4 + Inter + JetBrains Mono, 8-callout palette, dark mode)
// BEFORE the legacy global.css. Legacy red/Mondrian styles continue to win
// on overlapping selectors; new components in Phase 5.2+ consume the tokens
// directly.
import '@/styles/tokens.css';
import '@/styles/global.css';
// Phase 5.2: canonical-text typography overlay — retargets .article-body
// + .para-row family to Source Serif 4 + canonical leading + muted UI
// markers. Loads AFTER global.css so it wins on overlapping selectors.
import '@/styles/phase5-typography.css';
// Phase 5.7: chrome convergence overlay. Token redefinition retires
// the legacy red/cool-gray palette site-wide; legacy classes like
// .chapter-bar / .article-id / .topbar-brand get stone-toned styles
// here too. Loads AFTER phase5-typography.css so this file wins the
// :root cascade.
import '@/styles/phase5-chrome.css';
import TopBar from '@/components/TopBar.astro';
import type { Lang } from '@/types/aiact';

interface Props {
  title: string;
  activeChapter?: number;
  activeTopNav?: 'articles' | 'recitals' | 'annexes' | 'history' | 'guidance' | 'about';
  availableLangs?: readonly Lang[];
}

const { title, activeChapter, activeTopNav, availableLangs } = Astro.props;
const base = import.meta.env.BASE_URL;

const path = Astro.url.pathname;
const lang: Lang = path.startsWith('/nl/') ? 'nl' : 'en';
const noLang = path.replace(/^\/(en|nl)(\/|$)/, '/');

const topNav = activeTopNav
  ?? (noLang.startsWith('/recitals') ? 'recitals'
    : noLang.startsWith('/annexes') ? 'annexes'
    : noLang.startsWith('/history') ? 'history'
    : noLang.startsWith('/guidance') ? 'guidance'
    : noLang.startsWith('/about') ? 'about'
    : 'articles');

const siteOrigin = Astro.site ? Astro.site.origin : 'https://aiact.annotated.nl';
const canonicalUrl = `${siteOrigin}${path}`;
const enHref = `${siteOrigin}/en${noLang}`;
const nlHref = `${siteOrigin}/nl${noLang}`;

// Hreflang gap awareness — when the page exists in only one locale (drafting-
// history snapshots where the alt-language equivalent is absent per the
// catalogued asymmetry), the corresponding lang must be omitted from
// hreflang and x-default must point at the locale that actually exists.
// `availableLangs === undefined` means both locales render this page (the
// regulation-text default); both hreflang links are emitted as before.
const enAvailable = !availableLangs || availableLangs.includes('en');
const nlAvailable = !availableLangs || availableLangs.includes('nl');
const xDefaultHref = enAvailable ? enHref : nlHref;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — EU AI Act Annotated</title>
  <meta name="description" content="Annotated EU AI Act (Regulation 2024/1689) with recitals, drafting history, cross-references, and AI Omnibus amendments." />
  <link rel="canonical" href={canonicalUrl} />
  {enAvailable && <link rel="alternate" hreflang="en" href={enHref} />}
  {nlAvailable && <link rel="alternate" hreflang="nl" href={nlHref} />}
  <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
</head>
<body>

<TopBar lang={lang} currentPath={path} activeTopNav={topNav} availableLangs={availableLangs} />

<div class="layout">
<slot name="sidebar" />

<div class="main-wrapper">
  <main class="main">
    <slot />
  </main>

  <aside class="right-sidebar">
    <slot name="about-resource">
      <div class="rs-section">
        <h3>About This Resource</h3>
        <div class="rs-meta">Regulation (EU) 2024/1689</div>
        <div class="rs-meta">OJ L, 12.7.2024</div>
        <div class="rs-meta">Entry into force: 1 August 2024</div>
        <div class="rs-meta" style="margin-top: 6px; padding-top: 6px; border-top: 1px solid var(--gray-100);">Last updated: April 2026</div>
      </div>
    </slot>
    {/* Phase 6: forthcoming-changes slot — article pages fill this when
        the article has proposed / adopted-not-in-force amendments. */}
    <slot name="forthcoming-changes" />
    <div class="rs-section">
      <h3>Quick Links</h3>
      <a href="https://eur-lex.europa.eu/eli/reg/2024/1689/oj" target="_blank" rel="noopener">Full text on EUR-Lex</a>
      <a href="https://digital-strategy.ec.europa.eu/en/policies/european-approach-artificial-intelligence" target="_blank" rel="noopener">EU AI Office</a>
      <a href="https://ec.europa.eu/ai-act-service-desk" target="_blank" rel="noopener">AI Act Service Desk</a>
    </div>
    <div class="rs-section">
      <h3>Application Dates</h3>
      <div class="rs-meta"><strong style="color: var(--green-badge);">2 Feb 2025</strong> — Prohibited practices</div>
      <div class="rs-meta"><strong style="color: var(--green-badge);">2 Aug 2025</strong> — GPAI obligations</div>
      <div class="rs-meta"><strong style="color: var(--amber-badge);">2 Aug 2026</strong> — High-risk systems</div>
      <div class="rs-meta"><strong style="color: var(--gray-500);">2 Aug 2027</strong> — Annex I systems</div>
    </div>
    <div class="rs-section">
      <h3>Related Legislation</h3>
      <a href="#">GDPR (2016/679)</a>
      <a href="#">DSA (2022/2065)</a>
      <a href="#">DMA (2022/1925)</a>
      <a href="#">NIS2 (2022/2555)</a>
      <a href="#">DORA (2022/2554)</a>
      <a href="#">Product Liability Dir.</a>
    </div>
    <div class="rs-section">
      <h3>Contact</h3>
      <a href="https://abacuslegal.nl" target="_blank" rel="noopener">Abacus Legal</a>
      <a href="#">Suggest a correction</a>
    </div>
  </aside>
</div>

</div>

<script is:inline>
// Phase 5.5a (2026-05-12): generalised to query siblings and panels by
// the `data-tab` / `data-panel` attributes rather than the legacy
// `.article-tab` / `.tab-panel` class names. The new SupplementaryTabs +
// SupplementaryPanel components (which use `.supp-tab` / `.supp-panel`)
// share the same handler — class-agnostic dispatch was the cheapest way
// to avoid a parallel JS path.
function switchTab(tabEl) {
  const tabBar = tabEl.parentElement;
  const articleId = tabBar.dataset.article;
  const tabName = tabEl.dataset.tab;
  const panels = document.querySelectorAll(`[data-panel][data-article="${articleId}"]`);
  if (tabEl.classList.contains('active')) {
    tabEl.classList.remove('active');
    panels.forEach(p => p.classList.remove('active'));
    updateSuppUrl(getCurrentSuppState());
    return;
  }
  tabBar.querySelectorAll('[data-tab]').forEach(t => t.classList.remove('active'));
  panels.forEach(p => p.classList.remove('active'));
  tabEl.classList.add('active');
  const panel = document.querySelector(`[data-panel="${tabName}"][data-article="${articleId}"]`);
  if (panel) panel.classList.add('active');
  updateSuppUrl(getCurrentSuppState());
}

// Phase 5.5c: URL query-param state for the supplementary surface.
const LEGACY_HASH_TO_TAB = {
  recitals: 'recitals',
  history:  'history',
  guidance: 'guidance',
  omnibus:  null,
  caselaw:  null,
};

function readSuppUrlState() {
  const params = new URLSearchParams(location.search);
  const rawChips = params.get('chips');
  return {
    tab: params.get('tab') || null,
    mode: params.get('mode') === 'research' ? 'research' : null,
    chips: rawChips === null
      ? null
      : rawChips.split(',').map(s => s.trim()).filter(Boolean),
  };
}

function updateSuppUrl(state) {
  const params = new URLSearchParams(location.search);
  if (state.tab) params.set('tab', state.tab); else params.delete('tab');
  if (state.mode === 'research') params.set('mode', 'research'); else params.delete('mode');
  if (state.chips && state.chips.length) {
    params.set('chips', state.chips.join(','));
  } else {
    params.delete('chips');
  }
  const qs = params.toString();
  const newUrl = location.pathname + (qs ? '?' + qs : '') + (location.hash || '');
  try { history.replaceState(null, '', newUrl); } catch (_) {}
}

function getCurrentSuppState() {
  const root = document.querySelector('.supp-root');
  if (!root) return { tab: null, mode: null, chips: [] };
  const isResearch = root.getAttribute('data-supp-mode') === 'research';
  const activeTab = root.querySelector('[data-tab].active');
  const chips = Array.from(root.querySelectorAll('.supp-chip.active'))
    .map(c => c.dataset.chip)
    .filter(s => s && s !== 'all');
  return {
    tab: activeTab ? activeTab.dataset.tab : null,
    mode: isResearch ? 'research' : null,
    chips,
  };
}

function migrateLegacyHash() {
  const hash = (location.hash || '').replace(/^#/, '').toLowerCase();
  if (!(hash in LEGACY_HASH_TO_TAB)) return;
  const newTab = LEGACY_HASH_TO_TAB[hash];
  const params = new URLSearchParams(location.search);
  if (newTab) params.set('tab', newTab); else params.delete('tab');
  const qs = params.toString();
  const newUrl = location.pathname + (qs ? '?' + qs : '');
  try { history.replaceState(null, '', newUrl); } catch (_) {}
}

function applySupplementaryStateFromUrl() {
  const urlState = readSuppUrlState();
  const mode = urlState.mode || readSuppMode();
  applySuppMode(mode);
  const chips = urlState.chips !== null ? urlState.chips : readSuppChips();
  applyResearchChips(chips);
  if (urlState.tab) {
    document.querySelectorAll('.supp-root').forEach((root) => {
      const tab = root.querySelector('[data-tab="' + urlState.tab + '"]');
      if (tab && !tab.classList.contains('active')) {
        switchTab(tab);
      }
    });
  }
}

// Phase 5.5b: supplementary surface mode + chip-filter state.
const SUPP_MODE_KEY = 'aiact-supp-mode';
const SUPP_CHIPS_KEY = 'aiact-supp-chips';

function readSuppMode() {
  try {
    const v = sessionStorage.getItem(SUPP_MODE_KEY);
    return v === 'research' ? 'research' : 'browse';
  } catch (_) { return 'browse'; }
}
function writeSuppMode(mode) {
  try { sessionStorage.setItem(SUPP_MODE_KEY, mode); } catch (_) {}
}
function readSuppChips() {
  try {
    const raw = sessionStorage.getItem(SUPP_CHIPS_KEY);
    if (!raw) return [];
    const arr = JSON.parse(raw);
    return Array.isArray(arr) ? arr.filter((x) => typeof x === 'string') : [];
  } catch (_) { return []; }
}
function writeSuppChips(arr) {
  try { sessionStorage.setItem(SUPP_CHIPS_KEY, JSON.stringify(arr)); } catch (_) {}
}

function applySuppMode(mode) {
  document.querySelectorAll('.supp-root').forEach((root) => {
    root.setAttribute('data-supp-mode', mode);
    root.querySelectorAll('.supp-mode-button').forEach((btn) => {
      const isActive = btn.dataset.mode === mode;
      btn.classList.toggle('active', isActive);
      btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
    });
  });
}

function switchMode(buttonEl, mode) {
  applySuppMode(mode);
  writeSuppMode(mode);
  updateSuppUrl(getCurrentSuppState());
}

function applyResearchChips(activeChips) {
  document.querySelectorAll('.supp-research').forEach((panel) => {
    if (activeChips.length === 0) {
      panel.removeAttribute('data-supp-chips-active');
    } else {
      panel.setAttribute('data-supp-chips-active', activeChips.join(' '));
    }
    panel.querySelectorAll('.supp-research-entry').forEach((entry) => {
      const cat = entry.dataset.category;
      const isActive = activeChips.length === 0 || activeChips.includes(cat);
      entry.setAttribute('data-active', isActive ? 'true' : 'false');
    });
    panel.querySelectorAll('.supp-chip').forEach((chip) => {
      const slug = chip.dataset.chip;
      const isActive =
        (slug === 'all' && activeChips.length === 0) ||
        (slug !== 'all' && activeChips.includes(slug));
      chip.classList.toggle('active', isActive);
    });
  });
}

function toggleResearchChip(chipEl) {
  const slug = chipEl.dataset.chip;
  let active = readSuppChips();
  if (slug === 'all') {
    active = [];
  } else if (active.includes(slug)) {
    active = active.filter((s) => s !== slug);
  } else {
    active = [...active, slug];
  }
  writeSuppChips(active);
  applyResearchChips(active);
  updateSuppUrl(getCurrentSuppState());
}

function suppKeyboardR(ev) {
  if (ev.key !== 'r' && ev.key !== 'R') return;
  const t = ev.target;
  if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
  if (ev.metaKey || ev.ctrlKey || ev.altKey) return;
  if (!document.querySelector('.supp-root')) return;
  const next = readSuppMode() === 'research' ? 'browse' : 'research';
  applySuppMode(next);
  writeSuppMode(next);
  updateSuppUrl(getCurrentSuppState());
}

// Phase 5.6.1 (2026-05-12): inline search via raw Pagefind API.
// The modal pattern from 5.6 obscured article content; reverted to a
// dropdown panel anchored below the topbar search input so the reader
// can keep their place while searching. Pagefind module loaded lazily
// on first non-empty query; debounced at 180ms.
let _pf = null;
let _pfLoadFailed = false;
let _searchTimer = null;

async function loadPagefind() {
  if (_pf) return _pf;
  if (_pfLoadFailed) return null;
  try {
    const mod = await import('/pagefind/pagefind.js');
    _pf = mod;
    return _pf;
  } catch (err) {
    _pfLoadFailed = true;
    return null;
  }
}

function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, (c) => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;',
  })[c]);
}

function renderSearchResults(panel, results, total, query) {
  if (!results.length) {
    panel.innerHTML = '<div class="topbar-search-panel-empty">No results for &quot;' + escapeHtml(query) + '&quot;.</div>';
    panel.hidden = false;
    return;
  }
  const meta =
    '<div class="topbar-search-panel-meta"><b>' + total + '</b> result' +
    (total === 1 ? '' : 's') + ' for &quot;' + escapeHtml(query) + '&quot;</div>';
  const list = '<ul>' + results.map((r) => {
    const title = escapeHtml((r.meta && r.meta.title) || r.url);
    return '<li><a href="' + escapeHtml(r.url) + '">' +
      '<div class="topbar-search-panel-title">' + title + '</div>' +
      '<div class="topbar-search-panel-url">' + escapeHtml(r.url) + '</div>' +
      '<div class="topbar-search-panel-excerpt">' + r.excerpt + '</div>' +
      '</a></li>';
  }).join('') + '</ul>';
  panel.innerHTML = meta + list;
  panel.hidden = false;
}

function handleSearchInput(ev) {
  const q = (ev.target.value || '').trim();
  const panel = document.getElementById('search-results-panel');
  if (!panel) return;
  clearTimeout(_searchTimer);
  if (!q) {
    panel.hidden = true;
    panel.innerHTML = '';
    return;
  }
  _searchTimer = setTimeout(async () => {
    const pf = await loadPagefind();
    if (!pf) {
      panel.innerHTML = '<div class="topbar-search-panel-empty">Search index unavailable in this environment.</div>';
      panel.hidden = false;
      return;
    }
    const search = await pf.search(q);
    const total = search.results.length;
    const top = await Promise.all(search.results.slice(0, 10).map((r) => r.data()));
    renderSearchResults(panel, top, total, q);
  }, 180);
}

function closeSearchPanel() {
  const panel = document.getElementById('search-results-panel');
  if (panel) panel.hidden = true;
}

function handleSearchKeydown(ev) {
  if ((ev.metaKey || ev.ctrlKey) && (ev.key === 'k' || ev.key === 'K')) {
    ev.preventDefault();
    const input = document.getElementById('search-input');
    if (input) {
      input.focus();
      input.select();
    }
    return;
  }
  if (ev.key === 'Escape') {
    const input = document.getElementById('search-input');
    const panel = document.getElementById('search-results-panel');
    if (input && document.activeElement === input) {
      ev.preventDefault();
      input.value = '';
      input.blur();
      closeSearchPanel();
    } else if (panel && !panel.hidden) {
      ev.preventDefault();
      closeSearchPanel();
    }
  }
}

function handleClickOutsideSearch(ev) {
  const root = document.querySelector('[data-search-root]');
  if (root && !root.contains(ev.target)) {
    closeSearchPanel();
  }
}

function applyPlatformKbdLabel() {
  const isMac = /Mac|iPhone|iPad/.test(navigator.platform || '');
  document.querySelectorAll('[data-search-kbd]').forEach((el) => {
    el.textContent = isMac ? '⌘K' : 'Ctrl K';
  });
}

document.addEventListener('DOMContentLoaded', () => {
  // Phase 5.5c: legacy hash → query migration runs once before apply.
  migrateLegacyHash();
  applySupplementaryStateFromUrl();
  window.addEventListener('hashchange', () => {
    migrateLegacyHash();
    applySupplementaryStateFromUrl();
  });
  document.addEventListener('keydown', suppKeyboardR);

  // Phase 5.6.1: inline search wiring.
  applyPlatformKbdLabel();
  const searchInput = document.getElementById('search-input');
  if (searchInput) {
    searchInput.addEventListener('input', handleSearchInput);
    searchInput.addEventListener('focus', () => {
      const panel = document.getElementById('search-results-panel');
      if (panel && panel.innerHTML.trim()) {
        panel.hidden = false;
      }
    });
  }
  document.addEventListener('keydown', handleSearchKeydown);
  document.addEventListener('mousedown', handleClickOutsideSearch);

  document.querySelectorAll('.nav-chapter-header').forEach(header => {
    header.addEventListener('click', () => {
      header.parentElement.classList.toggle('open');
    });
  });
  document.querySelectorAll('.sidebar-expand-all').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.nav-chapter').forEach(c => c.classList.add('open'));
    });
  });
  document.querySelectorAll('.sidebar-collapse-all').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.nav-chapter').forEach(c => c.classList.remove('open'));
    });
  });
  document.querySelectorAll('.timeline-card').forEach(card => {
    card.addEventListener('click', () => card.classList.toggle('expanded'));
  });
  document.querySelectorAll('.timeline-compare-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const diffView = btn.nextElementSibling;
      if (diffView && diffView.classList.contains('diff-view')) {
        diffView.classList.toggle('active');
      }
    });
  });
});
</script>

</body>
</html>
