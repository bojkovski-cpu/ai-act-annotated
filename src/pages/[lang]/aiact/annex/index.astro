---
/**
 * Annexes index — /en/aiact/annex/ and /nl/aiact/annex/.
 *
 * Phase 1 (canonical-id URL contract, 2026-05-12). Replaces legacy
 * /[lang]/annexes/ once the redirect layer ships. Lists all 13 annexes
 * with their titles + Pattern (A/B/C) classification surfacing whether
 * point-grain URLs are minted for that annex.
 *
 * Visual treatment minimal — Phase 5 lands the GDPR design-system swap.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Sidebar from '@components/Sidebar.astro';
import { getAnnexes } from '@/lib/loader';
import type { Lang } from '@/types/aiact';

export function getStaticPaths() {
  const langs: Lang[] = ['en', 'nl'];
  return langs.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const annexes = getAnnexes(lang);
---

<BaseLayout title={lang === 'nl' ? 'Bijlagen — EU AI Act' : 'Annexes — EU AI Act Annotated'}>
  <Sidebar slot="sidebar" lang={lang} activeSection="annexes" />

  <div class="chapter-bar">
    <h1>{lang === 'nl' ? 'Bijlagen' : 'Annexes'}</h1>
  </div>

  <div style="padding: 8px 0 16px; font-family: var(--sans); font-size: 13px; color: var(--gray-500);">
    <a href={`/${lang}/`} style="color: var(--blue-accent); text-decoration: none;">{lang === 'nl' ? 'Start' : 'Home'}</a>
    <span style="margin: 0 6px;">/</span>
    <span>{lang === 'nl' ? 'Bijlagen' : 'Annexes'}</span>
  </div>

  <ul style="list-style: none; padding: 0; margin: 24px 0; font-family: var(--sans);">
    {annexes.map((annex) => (
      <li style="padding: 16px 0; border-bottom: 1px solid var(--gray-200);">
        <a
          href={`/${lang}/aiact/annex/${annex.id.toLowerCase()}/`}
          style="text-decoration: none; color: inherit; display: block;"
        >
          <div style="font-size: 12px; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.5px; font-family: var(--mono, var(--sans));">
            {annex.canonical_id}
          </div>
          <div style="font-size: 17px; font-weight: 600; color: var(--gray-900); margin-top: 4px;">
            {lang === 'nl' ? 'Bijlage' : 'Annex'} {annex.id} — {annex.title}
          </div>
          {annex.points.length > 0 && (
            <div style="font-size: 13px; color: var(--gray-600); margin-top: 4px;">
              {annex.points.length} {lang === 'nl' ? 'punten' : 'points'}
            </div>
          )}
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
