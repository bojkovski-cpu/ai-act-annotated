---
/**
 * Article detail — /en/aiact/art/N/ and /nl/aiact/art/N/.
 *
 * Phase 1 fork of /[lang]/articles/[chapter]/[article].astro with new URL
 * emission. Chapter is no longer in the URL (per url-contract decision);
 * chapter rubric still appears on the page via the ChapterBanner-style
 * heading. ArticleBlock component re-used as-is; inline cross-reference
 * links still emit legacy URLs (will be fixed in task #21).
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Sidebar from '@components/Sidebar.astro';
import ArticleBlock from '@components/ArticleBlock.astro';
import { getArticles, getChapters, getAmendmentCalloutsForArticle } from '@/lib/loader';
import type { Article, Lang } from '@/types/aiact';

export function getStaticPaths() {
  const langs: Lang[] = ['en', 'nl'];
  const out: Array<{ params: { lang: Lang; n: string }; props: { article: Article; lang: Lang } }> = [];
  for (const lang of langs) {
    for (const article of getArticles(lang)) {
      out.push({ params: { lang, n: article.number }, props: { article, lang } });
    }
  }
  return out;
}

interface Props { article: Article; lang: Lang }
const { article, lang } = Astro.props;

function titleCase(str: string) {
  return str.toLowerCase()
    .replace(/\b\w/g, (c) => c.toUpperCase())
    .replace(/\bAi\b/g, 'AI').replace(/\bEu\b/g, 'EU').replace(/\bGpai\b/g, 'GPAI');
}

const allArticles = getArticles(lang);
const idx = allArticles.findIndex((a) => a.number === article.number);
const prev = idx > 0 ? allArticles[idx - 1] : null;
const next = idx < allArticles.length - 1 ? allArticles[idx + 1] : null;

const chapter = getChapters(lang).find((c) => c.number === article.chapter);
const chapterTitle = chapter ? titleCase(chapter.title) : '';
const pageTitle = `${lang === 'nl' ? 'Artikel' : 'Article'} ${article.number} — ${article.title}`;

// Phase 6: forthcoming-changes sidebar block. Surfaces in the right
// sidebar when the article has proposed / adopted-not-in-force
// amendments. Filled into BaseLayout's `forthcoming-changes` slot below.
const articleAmendments = getAmendmentCalloutsForArticle(`aiact/art/${article.number}`)
  .filter((c) => c.status === 'proposed' || c.status === 'adopted-not-in-force');
const FORTHCOMING_HEADING: Record<Lang, string> = {
  en: 'Forthcoming changes',
  nl: 'Aankomende wijzigingen',
};
const FORTHCOMING_LABEL: Record<Lang, string> = {
  en: 'proposed',
  nl: 'voorgesteld',
};
const PARAGRAPH_LABEL: Record<Lang, string> = {
  en: 'paragraph',
  nl: 'alinea',
};
---

<BaseLayout title={pageTitle} activeChapter={article.chapter}>
  <Sidebar slot="sidebar" lang={lang} activeChapter={article.chapter} activeArticle={article.number} />

  {articleAmendments.length > 0 && (
    <div slot="forthcoming-changes" class="rs-section rs-forthcoming">
      <h3>{FORTHCOMING_HEADING[lang]}</h3>
      {articleAmendments.map((c) => {
        const instTitle =
          (lang === 'nl' && c.amendingInstrument.shortTitle.nl) ||
          c.amendingInstrument.shortTitle.en ||
          c.amendingInstrument.canonicalId;
        return (
          <div class="rs-forthcoming-item">
            <a href={`#amend-${c.id}`} class="rs-forthcoming-link">
              <div class="rs-forthcoming-when">
                {c.effectiveDate ? c.effectiveDate : FORTHCOMING_LABEL[lang]}
              </div>
              <div class="rs-forthcoming-what">
                {PARAGRAPH_LABEL[lang]} {c.affectedParagraphId} · {instTitle}
              </div>
            </a>
          </div>
        );
      })}
    </div>
  )}

  <div class="chapter-bar">
    <h1>
      <a href={`/${lang}/aiact/chapter/${article.chapter_roman.toLowerCase()}/`} style="color: inherit; text-decoration: none; opacity: 0.85;">{lang === 'nl' ? 'Hoofdstuk' : 'Chapter'} {chapter?.roman ?? article.chapter} — {chapterTitle}</a>
    </h1>
  </div>

  <div style="padding: 8px 0 16px; font-family: var(--sans); font-size: 13px; color: var(--gray-500);">
    <a href={`/${lang}/`} style="color: var(--blue-accent); text-decoration: none;">{lang === 'nl' ? 'Start' : 'Home'}</a>
    <span style="margin: 0 6px;">/</span>
    <a href={`/${lang}/aiact/art/`} style="color: var(--blue-accent); text-decoration: none;">{lang === 'nl' ? 'Artikelen' : 'Articles'}</a>
    <span style="margin: 0 6px;">/</span>
    <a href={`/${lang}/aiact/chapter/${article.chapter_roman.toLowerCase()}/`} style="color: var(--blue-accent); text-decoration: none;">{lang === 'nl' ? 'Hoofdstuk' : 'Chapter'} {chapter?.roman}</a>
    <span style="margin: 0 6px;">/</span>
    <span>{lang === 'nl' ? 'Artikel' : 'Article'} {article.number}</span>
  </div>

  <div style="margin: 8px 0 20px; font-family: var(--mono, var(--sans)); font-size: 11px; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.5px;">
    v{article.version_id}
  </div>

  <ArticleBlock article={article} lang={lang} />

  <nav style="display: flex; justify-content: space-between; gap: 16px; margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--stone-200); font-family: var(--sans);">
  <nav style="display: flex; justify-content: space-between; gap: 16px; margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--stone-200); font-family: var(--sans);">
    {prev ? (
      <a href={`/${lang}/aiact/art/${prev.number}/`}
         style="flex: 1; display: block; padding: 14px 18px; background: var(--gray-50); border: 1px solid var(--gray-200); border-left: 3px solid var(--red-accent); border-radius: 0 6px 6px 0; text-decoration: none; color: inherit;">
        <div style="font-size: 11px; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 4px;">&larr; {lang === 'nl' ? 'Vorige' : 'Previous'}</div>
        <div style="font-weight: 700; color: var(--red-accent); font-size: 14px;">{lang === 'nl' ? 'Artikel' : 'Article'} {prev.number}</div>
        <div style="font-size: 13px; color: var(--gray-600); margin-top: 2px;">{prev.title}</div>
      </a>
    ) : <div style="flex: 1;"></div>}
    {next ? (
      <a href={`/${lang}/aiact/art/${next.number}/`}
         style="flex: 1; display: block; padding: 14px 18px; background: var(--gray-50); border: 1px solid var(--gray-200); border-right: 3px solid var(--red-accent); border-radius: 6px 0 0 6px; text-decoration: none; color: inherit; text-align: right;">
        <div style="font-size: 11px; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 4px;">{lang === 'nl' ? 'Volgende' : 'Next'} &rarr;</div>
        <div style="font-weight: 700; color: var(--red-accent); font-size: 14px;">{lang === 'nl' ? 'Artikel' : 'Article'} {next.number}</div>
        <div style="font-size: 13px; color: var(--gray-600); margin-top: 2px;">{next.title}</div>
      </a>
    ) : <div style="flex: 1;"></div>}
  </nav>
</BaseLayout>

<style>
  /* Phase 6: forthcoming-changes sidebar block — surfaces in the
     right sidebar when the current article has pending amendments.
     Uses status-proposed amber palette matching the inline
     VersionBanner + AmendmentCallout components. */
  .rs-forthcoming {
    background: var(--status-proposed-bg, #f6e6c7);
    border: 1px solid color-mix(in srgb, var(--status-proposed-fg, #7a4a00) 25%, transparent);
    border-radius: 4px;
    padding: 0.6rem 0.7rem 0.4rem;
  }
  .rs-forthcoming h3 {
    color: var(--status-proposed-fg, #7a4a00);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 0.4rem;
    font-weight: 600;
  }
  .rs-forthcoming-item + .rs-forthcoming-item {
    margin-top: 0.45rem;
    padding-top: 0.45rem;
    border-top: 1px solid color-mix(in srgb, var(--status-proposed-fg, #7a4a00) 18%, transparent);
  }
  .rs-forthcoming-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .rs-forthcoming-when {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--status-proposed-fg, #7a4a00);
    margin-bottom: 0.1rem;
  }
  .rs-forthcoming-what {
    font-size: 12px;
    color: var(--stone-700, #3a382f);
    line-height: 1.4;
  }
  .rs-forthcoming-link:hover .rs-forthcoming-what {
    color: var(--stone-900, #15140f);
  }
</style>
