---
/**
 * Chapter detail — /en/aiact/chapter/[roman]/ and /nl/aiact/chapter/[roman]/.
 *
 * Phase 1 canonical-URL contract (Option b, roman numerals). Forked from
 * /[lang]/articles/[chapter]/index.astro with new URL emission and roman
 * numerals in the path instead of arabic.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Sidebar from '@components/Sidebar.astro';
import { getArticles, getChapters } from '@/lib/loader';
import type { Lang } from '@/types/aiact';

export function getStaticPaths() {
  const langs: Lang[] = ['en', 'nl'];
  const out: Array<{
    params: { lang: Lang; roman: string };
    props: { chapterNumber: number; lang: Lang };
  }> = [];
  for (const lang of langs) {
    for (const ch of getChapters(lang)) {
      out.push({
        params: { lang, roman: ch.roman.toLowerCase() },
        props: { chapterNumber: ch.number, lang },
      });
    }
  }
  return out;
}

interface Props { chapterNumber: number; lang: Lang }
const { chapterNumber, lang } = Astro.props;

function titleCase(str: string) {
  return str.toLowerCase()
    .replace(/\b\w/g, (c) => c.toUpperCase())
    .replace(/\bAi\b/g, 'AI').replace(/\bEu\b/g, 'EU').replace(/\bGpai\b/g, 'GPAI');
}

const allChapters = getChapters(lang);
const chapter = allChapters.find((c) => c.number === chapterNumber)!;
const articles = getArticles(lang).filter((a) => a.chapter === chapter.number);

const idx = allChapters.findIndex((c) => c.number === chapter.number);
const prev = idx > 0 ? allChapters[idx - 1] : null;
const next = idx < allChapters.length - 1 ? allChapters[idx + 1] : null;

const pageTitle = `${lang === 'nl' ? 'Hoofdstuk' : 'Chapter'} ${chapter.roman} — ${titleCase(chapter.title)}`;
---

<BaseLayout title={pageTitle} activeChapter={chapter.number}>
  <Sidebar slot="sidebar" lang={lang} activeChapter={chapter.number} />

  <div class="chapter-bar">
    <h1>{lang === 'nl' ? 'Hoofdstuk' : 'Chapter'} {chapter.roman} — {titleCase(chapter.title)}</h1>
  </div>

  <div style="padding: 8px 0 16px; font-family: var(--sans); font-size: 13px; color: var(--gray-500);">
    <a href={`/${lang}/`} style="color: var(--blue-accent); text-decoration: none;">{lang === 'nl' ? 'Start' : 'Home'}</a>
    <span style="margin: 0 6px;">/</span>
    <a href={`/${lang}/aiact/art/`} style="color: var(--blue-accent); text-decoration: none;">{lang === 'nl' ? 'Artikelen' : 'Articles'}</a>
    <span style="margin: 0 6px;">/</span>
    <span>{lang === 'nl' ? 'Hoofdstuk' : 'Chapter'} {chapter.roman}</span>
  </div>

  <div style="margin: 8px 0 20px; font-family: var(--mono, var(--sans)); font-size: 11px; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.5px;">
    aiact/chapter/{chapter.roman.toLowerCase()}
  </div>

  <p style="font-family: var(--sans); font-size: 14px; color: var(--gray-600); margin-bottom: 24px;">
    {articles.length} {lang === 'nl' ? 'artikelen in dit hoofdstuk' : 'articles in this chapter'}.
  </p>

  <ul style="list-style: none; padding: 0; margin: 0;">
    {articles.map((art) => (
      <li style="padding: 12px 0; border-bottom: 1px solid var(--gray-200);">
        <a href={`/${lang}/aiact/art/${art.number}/`} style="text-decoration: none; color: inherit; display: block;">
          <div style="font-family: var(--mono, var(--sans)); font-size: 11px; color: var(--gray-500); margin-bottom: 4px;">{art.canonical_id}</div>
          <div>
            <span style="font-weight: 700; color: var(--red-accent); margin-right: 8px;">{lang === 'nl' ? 'Artikel' : 'Article'} {art.number}</span>
            <span style="color: var(--gray-800);">{art.title}</span>
          </div>
        </a>
      </li>
    ))}
  </ul>

  <nav style="display: flex; justify-content: space-between; gap: 16px; margin-top: 40px; padding-top: 20px; border-top: 2px solid #111; font-family: var(--sans);">
    {prev ? (
      <a href={`/${lang}/aiact/chapter/${prev.roman.toLowerCase()}/`}
         style="flex: 1; display: block; padding: 14px 18px; background: var(--gray-50); border: 1px solid var(--gray-200); border-left: 3px solid var(--red-accent); border-radius: 0 6px 6px 0; text-decoration: none; color: inherit;">
        <div style="font-size: 11px; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 4px;">&larr; {lang === 'nl' ? 'Vorig hoofdstuk' : 'Previous chapter'}</div>
        <div style="font-weight: 700; color: var(--red-accent); font-size: 14px;">{lang === 'nl' ? 'Hoofdstuk' : 'Chapter'} {prev.roman} — {titleCase(prev.title)}</div>
      </a>
    ) : <div style="flex: 1;"></div>}
    {next ? (
      <a href={`/${lang}/aiact/chapter/${next.roman.toLowerCase()}/`}
         style="flex: 1; display: block; padding: 14px 18px; background: var(--gray-50); border: 1px solid var(--gray-200); border-right: 3px solid var(--red-accent); border-radius: 6px 0 0 6px; text-decoration: none; color: inherit; text-align: right;">
        <div style="font-size: 11px; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 4px;">{lang === 'nl' ? 'Volgend hoofdstuk' : 'Next chapter'} &rarr;</div>
        <div style="font-weight: 700; color: var(--red-accent); font-size: 14px;">{lang === 'nl' ? 'Hoofdstuk' : 'Chapter'} {next.roman} — {titleCase(next.title)}</div>
      </a>
    ) : <div style="flex: 1;"></div>}
  </nav>
</BaseLayout>
