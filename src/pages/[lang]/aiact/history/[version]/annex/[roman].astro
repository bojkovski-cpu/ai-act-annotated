---
/**
 * Annex snapshot detail — /[lang]/aiact/history/[version]/annex/[roman]/.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Sidebar from '@components/Sidebar.astro';
import { getDraftingHistory, getDraftingStages, getAnnex } from '@/lib/loader';
import type { Lang, DraftingSnapshot } from '@/types/aiact';

export function getStaticPaths() {
  const langs: Lang[] = ['en', 'nl'];
  const out: Array<{
    params: { lang: Lang; version: string; roman: string };
    props: { snapshot: DraftingSnapshot; lang: Lang };
  }> = [];
  for (const lang of langs) {
    const blob = getDraftingHistory(lang);
    for (const snap of blob.snapshots) {
      if (snap.content_type !== 'annexes') continue;
      out.push({ params: { lang, version: snap.stage, roman: snap.number.toLowerCase() }, props: { snapshot: snap, lang } });
    }
  }
  return out;
}

interface Props { snapshot: DraftingSnapshot; lang: Lang }
const { snapshot, lang } = Astro.props;
const stages = getDraftingStages(lang);
const stage = stages.find((s) => s.id === snapshot.stage)!;
const stageLabel = lang === 'nl' ? stage.label_nl : stage.label_en;
const liveAnnex = getAnnex(lang, snapshot.number);

const T = lang === 'nl'
  ? { home: 'Start', hist: 'Geschiedenis', annex: 'Bijlage', final: 'Eindtekst' }
  : { home: 'Home', hist: 'History', annex: 'Annex', final: 'Final adopted text' };
---
<BaseLayout title={`${T.annex} ${snapshot.number} — ${stageLabel} — EU AI Act`}>
  <Sidebar slot="sidebar" lang={lang} activeSection="history" />
  <div class="chapter-bar"><h1>{T.annex} {snapshot.number} — {stageLabel}</h1></div>
  <div style="padding: 8px 0 16px; font-family: var(--sans); font-size: 13px; color: var(--gray-500);">
    <a href={`/${lang}/`} style="color: var(--blue-accent); text-decoration: none;">{T.home}</a>
    <span style="margin: 0 6px;">/</span>
    <a href={`/${lang}/aiact/history/`} style="color: var(--blue-accent); text-decoration: none;">{T.hist}</a>
    <span style="margin: 0 6px;">/</span>
    <a href={`/${lang}/aiact/history/${stage.id}/`} style="color: var(--blue-accent); text-decoration: none;">{stageLabel}</a>
    <span style="margin: 0 6px;">/</span><span>{T.annex} {snapshot.number}</span>
  </div>
  <div style="margin: 8px 0 20px; font-family: var(--mono, var(--sans)); font-size: 11px; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.5px;">
    aiact/history/{stage.id}/annex/{snapshot.number.toLowerCase()} · {stage.date} ({stage.source_label})
  </div>
  {snapshot.title && <h2 style="font-family: var(--serif); font-size: 22px; margin: 0 0 16px; color: var(--gray-900);">{snapshot.title}</h2>}
  <div class="article-block">
    <div class="article-body">
      <pre style="white-space: pre-wrap; font-family: var(--serif); font-size: 15px; line-height: 1.7; color: var(--gray-800); margin: 0;">{snapshot.text}</pre>
    </div>
  </div>
  {liveAnnex && (
    <section style="margin-top: 32px; padding: 16px 20px; background: var(--gray-50); border-left: 3px solid var(--blue-accent); border-radius: 0 6px 6px 0; font-family: var(--sans); font-size: 14px;">
      <strong style="color: var(--gray-700);">{T.final}:</strong>
      <a href={`/${lang}/aiact/annex/${liveAnnex.id.toLowerCase()}/`} style="color: var(--blue-accent); margin-left: 6px;">{T.annex} {liveAnnex.id} — {liveAnnex.title}</a>
    </section>
  )}
</BaseLayout>
